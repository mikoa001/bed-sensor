// Configuration file for HA-SleepGuard Bed Sensor
// Copy and modify these values to match your setup

// ============================================
// WiFi Configuration
// ============================================
const char* WIFI_SSID = "YOUR_WIFI_SSID";           // Your WiFi network name
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";   // Your WiFi password

// ============================================
// MQTT Broker Configuration
// ============================================
const char* MQTT_SERVER = "192.168.1.100";          // Your MQTT broker IP address
const int MQTT_PORT = 1883;                          // MQTT broker port (usually 1883)
const char* MQTT_USER = "YOUR_MQTT_USER";           // MQTT username (leave as "" if no auth)
const char* MQTT_PASSWORD = "YOUR_MQTT_PASSWORD";   // MQTT password (leave as "" if no auth)
const char* MQTT_CLIENT_ID = "bed_sensor";          // Unique client ID for this device

// ============================================
// MQTT Topics
// ============================================
const char* STATE_TOPIC = "homeassistant/binary_sensor/bed_sensor/state";
const char* CONFIG_TOPIC = "homeassistant/binary_sensor/bed_sensor/config";
const char* AVAILABILITY_TOPIC = "homeassistant/binary_sensor/bed_sensor/availability";

// ============================================
// Sensor Configuration
// ============================================
const int SENSOR_PIN = A0;                          // Analog pin for sensor (A0 on ESP8266)
const int OCCUPIED_THRESHOLD = 512;                 // Threshold value (calibrate this!)
                                                    // Values ABOVE this = bed occupied
                                                    // Values BELOW this = bed empty

// ============================================
// Debounce Configuration
// ============================================
const unsigned long DEBOUNCE_DELAY = 3000;          // Debounce delay in milliseconds
                                                    // Increase if getting false triggers
                                                    // (3000 = 3 seconds)

// ============================================
// Device Information (for Home Assistant)
// ============================================
const char* DEVICE_NAME = "Bed Sensor";             // Device name shown in HA
const char* DEVICE_MANUFACTURER = "HA-SleepGuard";  // Manufacturer name
const char* DEVICE_MODEL = "ESP8266 Bed Sensor";    // Model name
const char* UNIQUE_ID = "bed_sensor_001";           // Unique identifier (change if multiple sensors)

